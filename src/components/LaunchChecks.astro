---
import { type Locale } from '../i18n/config';
import { t } from '../i18n/copy';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
---

<section class="reveal mx-auto max-w-6xl px-4 py-16 sm:px-6">
	<h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">{copy.launchChecks.title}</h2>
	<p class="mt-3 max-w-2xl text-white/75">{copy.launchChecks.intro}</p>
	<ul class="mt-8 grid gap-3 sm:grid-cols-2">
		{
			copy.launchChecks.items.map((item) => (
				<li class="rounded-2xl border border-white/10 bg-panel px-4 py-3 text-sm text-white/80">{item}</li>
			))
		}
	</ul>
</section>
