---
import { type Locale, type PageId, type ServiceId } from '../i18n/config';
import { t } from '../i18n/copy';
import { switchLocalePath } from '../i18n/utils';

interface Props {
	locale: Locale;
	page: PageId;
	service?: ServiceId;
}

const { locale, page, service } = Astro.props;
const copy = t(locale);
const href = switchLocalePath(locale, page, service);
---

<div class="inline-flex items-center rounded-full border border-line p-0.5 text-xs font-semibold">
	{
		locale === 'en' ? (
			<span class="rounded-full bg-page-soft px-2.5 py-1 text-fg" aria-current="true">
				{copy.language.en}
			</span>
		) : (
			<a class="px-2.5 py-1 text-muted hover:text-fg" href={href} lang="en" hreflang="en">
				{copy.language.en}
			</a>
		)
	}
	{
		locale === 'es' ? (
			<span class="rounded-full bg-page-soft px-2.5 py-1 text-fg" aria-current="true">
				{copy.language.es}
			</span>
		) : (
			<a class="px-2.5 py-1 text-muted hover:text-fg" href={href} lang="es" hreflang="es">
				{copy.language.es}
			</a>
		)
	}
	<span class="sr-only">{copy.language.switchTo}</span>
</div>
