---
import { BRAND, hrefFor, navPageIds, type Locale } from '../i18n/config';
import { t } from '../i18n/copy';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const year = new Date().getFullYear();
const links = navPageIds;
---

<footer class="border-t border-line">
	<div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:px-6 md:grid-cols-3">
		<div>
			<p class="text-lg font-semibold italic">{BRAND}</p>
			<p class="mt-2 max-w-xs text-sm text-muted">{copy.footer.tagline}</p>
		</div>
		<nav class="flex flex-col gap-2 text-sm" aria-label={copy.footer.nav}>
			{
				links.map((id) => (
					<a class="text-muted hover:text-fg" href={hrefFor(locale, id)}>
						{id === 'contact' ? copy.common.ctaPrimary : copy.nav[id]}
					</a>
				))
			}
		</nav>
		<p class="text-sm text-muted">
			© {year} {BRAND}. {copy.footer.rights}
		</p>
	</div>
</footer>
