---
import { hrefFor, withBase, type Locale } from '../i18n/config';
import { t } from '../i18n/copy';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
---

<section class="relative overflow-hidden pixel-grid">
	<div class="pointer-events-none absolute -left-24 top-10 h-64 w-64 rounded-full bg-cyan/10 blur-3xl"></div>
	<div class="pointer-events-none absolute right-0 top-24 h-72 w-72 rounded-full bg-magenta/10 blur-3xl"></div>
	<div
		class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 py-20 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:py-28"
	>
		<div>
			<p class="text-xs font-semibold uppercase tracking-[0.2em] text-cyan">{copy.hero.eyebrow}</p>
			<h1 class="mt-4 text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
				{copy.hero.titleBefore}
				{' '}
				<span class="gradient-text">{copy.hero.titleAccent}</span>
				{' '}
				{copy.hero.titleAfter}
			</h1>
			<p class="mt-6 max-w-xl text-lg text-white/75">{copy.hero.body}</p>
			<div class="mt-8 flex flex-wrap gap-3">
				<a
					href={hrefFor(locale, 'contact')}
					class="glow-btn rounded-full bg-gradient-to-r from-cyan via-magenta to-orange px-5 py-3 text-sm font-semibold text-ink"
				>
					{copy.common.ctaPrimary}
				</a>
				<a
					href={hrefFor(locale, 'work')}
					class="btn-quiet rounded-full border border-white/15 px-5 py-3 text-sm font-semibold text-white hover:border-white/40"
				>
					{copy.common.ctaSecondary}
				</a>
			</div>
		</div>
		<div class="flex justify-center lg:justify-end">
			<div class="relative w-full max-w-md">
				<span class="pixel-speck pixel-speck-a" aria-hidden="true"></span>
				<span class="pixel-speck pixel-speck-b" aria-hidden="true"></span>
				<span class="pixel-speck pixel-speck-c" aria-hidden="true"></span>
				<img
					src={withBase('/logo.png')}
					alt={copy.common.brandAlt}
					class="logo-float w-full"
					width="640"
					height="360"
				/>
			</div>
		</div>
	</div>
</section>
