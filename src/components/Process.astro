---
import { type Locale } from '../i18n/config';
import { t, type ProcessStepId } from '../i18n/copy';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const ids: ProcessStepId[] = ['discover', 'design', 'build', 'qa', 'launch'];
---

<section class="reveal mx-auto max-w-6xl px-4 py-16 sm:px-6">
	<h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">{copy.process.title}</h2>
	<p class="mt-3 max-w-2xl text-muted">{copy.process.intro}</p>
	<ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
		{
			ids.map((id, index) => (
				<li
					class:list={[
						'lift-card rounded-2xl border bg-page-soft p-4',
						id === 'qa' ? 'process-step-qa border-cyan/45' : 'border-line',
					]}
				>
					<p class="text-xs font-semibold uppercase tracking-widest text-cyan">0{index + 1}</p>
					<h3 class="mt-2 font-semibold">{copy.process.steps[id].title}</h3>
					<p class="mt-2 text-sm text-muted">{copy.process.steps[id].body}</p>
				</li>
			))
		}
	</ol>
</section>
