---
import { type Locale } from '../i18n/config';
import { t } from '../i18n/copy';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
---

<section class="reveal mx-auto max-w-6xl px-4 py-16 sm:px-6">
	<h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">{copy.proof.title}</h2>
	<p class="mt-3 max-w-2xl text-white/75">{copy.proof.body}</p>
	<ul class="mt-8 flex flex-wrap gap-2">
		{
			copy.proof.items.map((item) => (
				<li class="rounded-full border border-white/15 bg-panel px-3 py-1.5 text-sm text-white/80">{item}</li>
			))
		}
	</ul>
	<h3 class="mt-12 text-lg font-semibold tracking-tight">{copy.proof.benefitsTitle}</h3>
	<ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
		{
			copy.proof.benefits.map((item) => (
				<li class="rounded-2xl border border-white/10 bg-panel p-4">
					<p class="font-semibold text-cyan">{item.title}</p>
					<p class="mt-2 text-sm text-white/75">{item.body}</p>
				</li>
			))
		}
	</ul>
</section>
