---
import { CONTACT_EMAIL, serviceSlugs, type Locale } from '../i18n/config';
import { t, type AudienceId } from '../i18n/copy';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const audiences: AudienceId[] = ['local', 'startup'];
const needs = ['build', 'design', 'optimize', 'qa', 'unsure'] as const;
const formAction = `https://formsubmit.co/${encodeURIComponent(CONTACT_EMAIL)}`;
const errorMessage = copy.contact.error.replace('{email}', CONTACT_EMAIL);
const nextUrl = new URL(Astro.url);
nextUrl.searchParams.set('sent', '1');
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
const fieldClass =
	'mt-2 w-full rounded-lg border border-line bg-page-soft px-3 py-2 text-fg outline-none focus:border-cyan';
const formCopy = {
	contextual: copy.contact.contextual,
	needOptions: copy.contact.needOptions,
	slugs: serviceSlugs[locale],
};
---

<section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
	<h1 id="contact-heading" class="text-3xl font-bold tracking-tight sm:text-4xl">{copy.contact.title}</h1>
	<p id="contact-intro" class="mt-4 text-muted">{copy.contact.intro}</p>

	<form
		id="contact-form"
		class="relative mt-10 space-y-5"
		action={formAction}
		method="POST"
		accept-charset="UTF-8"
		novalidate
		data-email={CONTACT_EMAIL}
		data-sending={copy.contact.sending}
		data-success={copy.contact.success}
		data-error={errorMessage}
		data-copy={JSON.stringify(formCopy)}
		data-errors={JSON.stringify(copy.contact.errors)}
		data-supabase-url={supabaseUrl}
		data-supabase-anon={supabaseAnonKey}
	>
		<input type="hidden" name="_subject" value={copy.contact.subject} />
		<input type="hidden" name="_template" value="table" />
		<input type="hidden" name="_captcha" value="false" />
		<input type="hidden" name="_next" value={nextUrl.href} />
		<input type="hidden" name="language" value={locale === 'es' ? 'es' : 'en'} />
		<label class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
			{copy.contact.honeypot}
			<input type="text" name="_honey" tabindex="-1" autocomplete="off" />
		</label>
		<div id="need-wrap">
			<label class="block text-sm font-medium">
				{copy.contact.need}
				<select name="need" required class={fieldClass} aria-describedby="need-error">
					<option value="" disabled selected>
						{copy.contact.selectPlaceholder}
					</option>
					{
						needs.map((id) => (
							<option value={id}>{copy.contact.needOptions[id]}</option>
						))
					}
				</select>
			</label>
			<p id="need-error" class="mt-1 text-sm text-red-400" data-error-for="need" hidden></p>
		</div>
		<label class="block text-sm font-medium">
			<span id="message-label">{copy.contact.message}</span>
			<textarea name="message" required rows="5" class={fieldClass} aria-describedby="message-error"></textarea>
			<p id="message-error" class="mt-1 text-sm text-red-400" data-error-for="message" hidden></p>
		</label>
		<label class="block text-sm font-medium">
			{copy.contact.name}
			<input name="name" type="text" required autocomplete="name" class={fieldClass} aria-describedby="name-error" />
			<p id="name-error" class="mt-1 text-sm text-red-400" data-error-for="name" hidden></p>
		</label>
		<label class="block text-sm font-medium">
			{copy.contact.email}
			<input name="email" type="email" required autocomplete="email" class={fieldClass} aria-describedby="email-error" />
			<p id="email-error" class="mt-1 text-sm text-red-400" data-error-for="email" hidden></p>
		</label>
		<label class="block text-sm font-medium">
			{copy.contact.website}
			<span id="website-hint" class="font-normal text-muted"> — {copy.contact.websiteHint}</span>
			<input
				id="website-input"
				name="website"
				type="url"
				inputmode="url"
				placeholder="https://"
				class={fieldClass}
				aria-describedby="website-error"
			/>
			<p id="website-error" class="mt-1 text-sm text-red-400" data-error-for="website" hidden></p>
		</label>
		<div id="audience-wrap">
			<label class="block text-sm font-medium">
				{copy.contact.audience}
				<select name="audience" required class={fieldClass} aria-describedby="audience-error">
					<option value="" disabled selected>
						{copy.contact.selectPlaceholder}
					</option>
					{
						audiences.map((id) => (
							<option value={id}>{copy.contact.audienceOptions[id]}</option>
						))
					}
				</select>
			</label>
			<p id="audience-error" class="mt-1 text-sm text-red-400" data-error-for="audience" hidden></p>
		</div>
		<p id="contact-status" class="text-sm text-muted" role="status" aria-live="polite" hidden></p>
		<button
			type="submit"
			class="glow-btn rounded-full px-6 py-3 text-sm font-semibold text-ink disabled:cursor-not-allowed disabled:opacity-60"
		>
			{copy.contact.submit}
		</button>
		<p class="text-sm text-muted">{copy.contact.mailtoNote}</p>
	</form>
</section>

<script>
	const form = document.getElementById('contact-form');
	const status = document.getElementById('contact-status');

	function setStatus(kind: 'success' | 'error' | 'info', message: string) {
		if (!(status instanceof HTMLParagraphElement)) return;
		status.hidden = message.length === 0;
		status.textContent = message;
		status.className =
			kind === 'success' ? 'text-sm text-cyan' : kind === 'error' ? 'text-sm text-red-400' : 'text-sm text-muted';
	}

	type FormCopy = {
		contextual: {
			title: string;
			intro: string;
			serviceLabel: string;
			problem: Record<string, string>;
			submit: Record<string, string>;
		};
		needOptions: Record<string, string>;
		slugs: Record<string, string>;
	};

	type FieldErrors = {
		need: string;
		message: string;
		name: string;
		email: string;
		website: string;
		websiteRequired: string;
		audience: string;
	};

	function parseErrors(raw: string | undefined): FieldErrors | null {
		if (!raw) return null;
		try {
			return JSON.parse(raw) as FieldErrors;
		} catch {
			return null;
		}
	}

	function isValidEmail(value: string) {
		return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
	}

	function isValidUrl(value: string) {
		try {
			const url = new URL(value);
			return url.protocol === 'http:' || url.protocol === 'https:';
		} catch {
			return false;
		}
	}

	function fieldControl(root: HTMLFormElement, name: string) {
		const field = root.elements.namedItem(name);
		return field instanceof HTMLInputElement ||
			field instanceof HTMLSelectElement ||
			field instanceof HTMLTextAreaElement
			? field
			: null;
	}

	function setFieldError(root: HTMLFormElement, name: string, message: string) {
		const field = fieldControl(root, name);
		const error = root.querySelector(`[data-error-for="${name}"]`);
		if (error instanceof HTMLElement) {
			error.hidden = message.length === 0;
			error.textContent = message;
		}
		if (!field) return;
		field.setAttribute('aria-invalid', message ? 'true' : 'false');
		field.classList.toggle('!border-red-400', message.length > 0);
	}

	function clearFieldErrors(root: HTMLFormElement) {
		for (const name of ['need', 'message', 'name', 'email', 'website', 'audience']) {
			setFieldError(root, name, '');
		}
	}

	function validateForm(root: HTMLFormElement, errors: FieldErrors) {
		clearFieldErrors(root);
		let firstInvalid: HTMLElement | null = null;

		const need = fieldControl(root, 'need');
		if (need && !need.value.trim()) {
			setFieldError(root, 'need', errors.need);
			firstInvalid ??= need;
		}

		const message = fieldControl(root, 'message');
		if (message && !message.value.trim()) {
			setFieldError(root, 'message', errors.message);
			firstInvalid ??= message;
		}

		const name = fieldControl(root, 'name');
		if (name && !name.value.trim()) {
			setFieldError(root, 'name', errors.name);
			firstInvalid ??= name;
		}

		const email = fieldControl(root, 'email');
		if (email && !isValidEmail(email.value.trim())) {
			setFieldError(root, 'email', errors.email);
			firstInvalid ??= email;
		}

		const website = fieldControl(root, 'website');
		if (website) {
			const value = website.value.trim();
			if (website.required && !value) {
				setFieldError(root, 'website', errors.websiteRequired);
				firstInvalid ??= website;
			} else if (value && !isValidUrl(value)) {
				setFieldError(root, 'website', errors.website);
				firstInvalid ??= website;
			}
		}

		const audience = fieldControl(root, 'audience');
		if (audience instanceof HTMLSelectElement && !audience.value.trim()) {
			setFieldError(root, 'audience', errors.audience);
			firstInvalid ??= audience;
		}

		return firstInvalid;
	}

	function resolveNeed(params: URLSearchParams, parsed: FormCopy) {
		const need = params.get('need');
		if (need && need in parsed.needOptions) return need;
		const slug = params.get('service');
		if (!slug) return null;
		const match = Object.entries(parsed.slugs).find(([, value]) => value === slug);
		return match && match[0] in parsed.needOptions ? match[0] : null;
	}

	function applyNeedFromQuery(root: HTMLFormElement) {
		const raw = root.dataset.copy;
		if (!raw) return;
		let parsed: FormCopy;
		try {
			parsed = JSON.parse(raw) as FormCopy;
		} catch {
			return;
		}
		const need = resolveNeed(new URLSearchParams(window.location.search), parsed);
		if (!need || !(need in parsed.slugs)) return;

		const heading = document.getElementById('contact-heading');
		const intro = document.getElementById('contact-intro');
		const needWrap = document.getElementById('need-wrap');
		const audienceWrap = document.getElementById('audience-wrap');
		const messageLabel = document.getElementById('message-label');
		const websiteHint = document.getElementById('website-hint');
		const websiteInput = document.getElementById('website-input');
		const submitButton = root.querySelector('button[type="submit"]');

		if (heading) heading.textContent = parsed.contextual.title;
		if (intro) intro.textContent = parsed.contextual.intro;
		if (messageLabel) messageLabel.textContent = parsed.contextual.problem[need] ?? messageLabel.textContent;
		if (submitButton) submitButton.textContent = parsed.contextual.submit[need] ?? submitButton.textContent;

		if (needWrap) {
			const label = parsed.needOptions[need];
			const box = document.createElement('div');
			box.className = 'block text-sm font-medium';
			box.append(parsed.contextual.serviceLabel);
			const value = document.createElement('p');
			value.className = 'mt-2 rounded-lg border border-line bg-page-soft px-3 py-2 text-fg';
			value.textContent = label;
			const hidden = document.createElement('input');
			hidden.type = 'hidden';
			hidden.name = 'need';
			hidden.value = need;
			box.append(value, hidden);
			needWrap.replaceChildren(box);
		}
		if (audienceWrap) audienceWrap.remove();
		if (websiteInput instanceof HTMLInputElement && need !== 'build') {
			websiteInput.required = true;
			websiteHint?.remove();
		}
	}

	if (form instanceof HTMLFormElement) {
		applyNeedFromQuery(form);

		const submitButton = form.querySelector('button[type="submit"]');
		const defaultLabel = submitButton instanceof HTMLButtonElement ? submitButton.textContent : '';
		const successMessage = form.dataset.success ?? '';
		const errorMessage = form.dataset.error ?? '';
		const sendingLabel = form.dataset.sending ?? '';
		const inbox = form.dataset.email ?? '';
		const supabaseUrl = form.dataset.supabaseUrl ?? '';
		const supabaseAnon = form.dataset.supabaseAnon ?? '';
		const fieldErrors = parseErrors(form.dataset.errors);

		form.addEventListener('input', (event) => {
			const target = event.target;
			if (
				target instanceof HTMLInputElement ||
				target instanceof HTMLSelectElement ||
				target instanceof HTMLTextAreaElement
			) {
				setFieldError(form, target.name, '');
			}
		});
		form.addEventListener('change', (event) => {
			const target = event.target;
			if (target instanceof HTMLSelectElement) {
				setFieldError(form, target.name, '');
			}
		});

		const params = new URLSearchParams(window.location.search);
		if (params.get('sent') === '1') {
			setStatus('success', successMessage);
			params.delete('sent');
			const query = params.toString();
			history.replaceState({}, '', `${window.location.pathname}${query ? `?${query}` : ''}${window.location.hash}`);
		}

		form.addEventListener('submit', async (event) => {
			event.preventDefault();

			if (fieldErrors) {
				const invalid = validateForm(form, fieldErrors);
				if (invalid) {
					setStatus('info', '');
					invalid.focus();
					invalid.scrollIntoView({ block: 'center', behavior: 'smooth' });
					return;
				}
			}

			const honey = form.querySelector('input[name="_honey"]');
			if (honey instanceof HTMLInputElement && honey.value.trim() !== '') {
				setStatus('success', successMessage);
				form.reset();
				return;
			}

			if (!(submitButton instanceof HTMLButtonElement)) return;

			submitButton.disabled = true;
			submitButton.textContent = sendingLabel;
			form.setAttribute('aria-busy', 'true');
			setStatus('info', sendingLabel);

			const formData = new FormData(form);
			const payload = Object.fromEntries(formData.entries());

			try {
				if (supabaseUrl && supabaseAnon) {
					const response = await fetch(`${supabaseUrl.replace(/\/$/, '')}/functions/v1/capture-lead`, {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json',
							Accept: 'application/json',
							apikey: supabaseAnon,
						},
						body: JSON.stringify({
							name: String(payload.name ?? ''),
							email: String(payload.email ?? ''),
							website: String(payload.website ?? ''),
							message: String(payload.message ?? ''),
							need: String(payload.need ?? ''),
							audience: String(payload.audience ?? ''),
							language: String(payload.language ?? ''),
							_honey: String(payload._honey ?? ''),
						}),
					});
					const result = (await response.json()) as { ok?: boolean; error?: string };
					if (!response.ok || !result.ok) {
						throw new Error(result.error ?? 'capture-lead failed');
					}
				} else {
					const response = await fetch(`https://formsubmit.co/ajax/${encodeURIComponent(inbox)}`, {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json',
							Accept: 'application/json',
						},
						body: JSON.stringify(payload),
					});
					const result = (await response.json()) as { success?: boolean | string };
					const ok = result.success === true || result.success === 'true';
					if (!response.ok || !ok) {
						throw new Error('FormSubmit rejected the request');
					}
				}

				form.reset();
				clearFieldErrors(form);
				setStatus('success', successMessage);
			} catch {
				setStatus('error', errorMessage);
			} finally {
				submitButton.disabled = false;
				submitButton.textContent = defaultLabel;
				form.removeAttribute('aria-busy');
			}
		});
	}
</script>
