---
import { hrefFor, type Locale } from '../i18n/config';
import { t } from '../i18n/copy';

interface Props {
	locale: Locale;
	limit?: number;
	showLink?: boolean;
	heading?: 'h1' | 'h2';
}

const { locale, limit, showLink = false, heading = 'h2' } = Astro.props;
const copy = t(locale);
const cases = typeof limit === 'number' ? copy.work.cases.slice(0, limit) : copy.work.cases;
const Heading = heading;
const gridClass =
	cases.length === 0
		? 'mt-10'
		: cases.length === 1
			? 'mt-10 max-w-xl'
			: 'mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3';
---

<section class="reveal mx-auto max-w-6xl px-4 py-16 sm:px-6">
	<div class="flex flex-wrap items-end justify-between gap-4">
		<div>
			<Heading class="text-2xl font-semibold tracking-tight sm:text-3xl">{copy.work.title}</Heading>
			<p class="mt-3 max-w-2xl text-white/75">{copy.work.intro}</p>
		</div>
		{
			showLink && (
				<a class="text-sm font-medium text-cyan hover:underline" href={hrefFor(locale, 'work')}>
					{copy.common.ctaSecondary}
				</a>
			)
		}
	</div>
	<div class={gridClass}>
		{
			cases.length === 0 ? (
				<div class="max-w-xl rounded-2xl border border-dashed border-white/20 bg-panel/60 p-5">
					<p class="text-xs font-semibold uppercase tracking-widest text-cyan">
						{copy.work.comingSoonTitle}
					</p>
					<p class="mt-2 text-sm text-white/75">{copy.work.comingSoonBody}</p>
				</div>
			) : (
				cases.map((item) => {
					const inner = (
						<>
							<p class="text-xs font-semibold uppercase tracking-widest text-white/70">
								{item.tag === 'local' ? copy.audiences.localTitle : copy.audiences.startupTitle}
							</p>
							<h3 class="mt-3 text-lg font-semibold">{item.title}</h3>
							<p class="mt-3 text-sm text-white/75">{item.summary}</p>
							<p class="mt-4 text-sm font-medium text-magenta">{item.result}</p>
							{item.url && (
								<span class="mt-4 inline-flex text-sm font-medium text-cyan">{copy.work.visitSite}</span>
							)}
						</>
					);
					return item.url ? (
						<a
							class="lift-card block rounded-2xl border border-white/10 bg-panel p-6 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan"
							href={item.url}
							target="_blank"
							rel="noopener noreferrer"
						>
							{inner}
						</a>
					) : (
						<article class="lift-card rounded-2xl border border-white/10 bg-panel p-6">{inner}</article>
					);
				})
			)
		}
	</div>
</section>
