---
import CtaBanner from './CtaBanner.astro';
import { hrefFor, hrefForContact, type Locale, type ServiceId } from '../i18n/config';
import { t } from '../i18n/copy';

interface Props {
	locale: Locale;
	service: ServiceId;
}

const { locale, service } = Astro.props;
const copy = t(locale);
const item = copy.services.items[service];
const contactHref = hrefForContact(locale, service);
const servicesHref = hrefFor(locale, 'services');
---

<section class="mx-auto max-w-6xl px-4 pt-12 pb-8 sm:px-6 sm:pt-16">
	<nav class="text-sm text-white/70" aria-label={copy.common.breadcrumb}>
		<ol class="flex flex-wrap items-center gap-2">
			<li>
				<a class="hover:text-white" href={servicesHref}>
					{copy.nav.services}
				</a>
			</li>
			<li aria-hidden="true">/</li>
			<li class="text-white" aria-current="page">{item.title}</li>
		</ol>
	</nav>

	<p class="mt-6 text-xs font-semibold uppercase tracking-[0.2em] text-cyan">{item.title}</p>
	<h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">{item.hero}</h1>
	<a
		href={contactHref}
		class="glow-btn mt-8 inline-flex rounded-full bg-gradient-to-r from-cyan via-magenta to-orange px-6 py-3 text-sm font-semibold text-ink"
	>
		{item.cta}
	</a>
</section>

<section class="reveal mx-auto max-w-6xl px-4 py-10 sm:px-6">
	<h2 class="text-2xl font-semibold tracking-tight">{copy.services.problemHeading}</h2>
	<p class="mt-4 max-w-2xl text-white/75">{item.problemBody}</p>
</section>

<section class="reveal mx-auto max-w-6xl px-4 py-10 sm:px-6">
	<h2 class="text-2xl font-semibold tracking-tight">{copy.services.whatWeDoHeading}</h2>
	<p class="mt-3 max-w-2xl text-white/75">{copy.services.whatWeDoIntro}</p>
	<div class="mt-8 grid gap-6 sm:grid-cols-2">
		{
			item.work.map((group, index) => (
				<div class="rounded-2xl border border-white/10 bg-panel p-6">
					<p class="text-xs font-semibold tracking-[0.2em] text-cyan">{String(index + 1).padStart(2, '0')}</p>
					<h3 class="mt-2 text-lg font-semibold">{group.title}</h3>
					<ul class="mt-4 list-disc space-y-1 pl-5 text-sm text-white/75">
						{group.items.map((entry) => (
							<li>{entry}</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</section>

<section class="reveal mx-auto max-w-6xl px-4 py-10 sm:px-6">
	<h2 class="text-2xl font-semibold tracking-tight">{copy.services.includedHeading}</h2>
	<ul class="mt-6 max-w-2xl list-disc space-y-2 pl-5 text-white/75">
		{item.included.map((entry) => <li>{entry}</li>)}
	</ul>
</section>

<section class="reveal mx-auto max-w-6xl px-4 py-10 sm:px-6">
	<h2 class="text-2xl font-semibold tracking-tight">{copy.services.youGetHeading}</h2>
	<p class="mt-3 text-white/75">{copy.services.youGetIntro}</p>
	<ul class="mt-6 max-w-2xl list-disc space-y-2 pl-5 text-white/75">
		{item.youGet.map((entry) => <li>{entry}</li>)}
	</ul>
</section>

<section class="reveal mx-auto max-w-6xl px-4 py-10 sm:px-6">
	<h2 class="text-2xl font-semibold tracking-tight">{copy.services.forYouHeading}</h2>
	<ul class="mt-6 max-w-2xl list-disc space-y-2 pl-5 text-white/75">
		{item.forYou.map((entry) => <li>{entry}</li>)}
	</ul>
</section>

<CtaBanner locale={locale} title={item.ctaTitle} body={item.ctaBody} button={item.cta} href={contactHref} />
