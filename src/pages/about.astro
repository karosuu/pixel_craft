---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { t } from '../i18n/copy';

const locale = 'en' as const;
const copy = t(locale);
const paragraphs = copy.about.body;
const closing = paragraphs.at(-1);
const body = paragraphs.slice(0, -1);
---

<BaseLayout locale={locale} page="about" title={copy.meta.aboutTitle} description={copy.meta.aboutDescription}>
	<section class="reveal mx-auto max-w-6xl px-4 py-16 text-left sm:px-6">
		<div class="max-w-2xl">
			<h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{copy.about.title}</h1>
			<p class="mt-6 text-lg leading-relaxed text-fg sm:text-xl">{copy.about.lede}</p>
			<div class="mt-8 space-y-5 text-base leading-relaxed text-muted sm:text-lg">
				{body.map((paragraph) => <p>{paragraph}</p>)}
			</div>
			{
				closing && (
					<p class="mt-10 border-t border-line pt-8 text-lg font-medium leading-relaxed text-fg">
						{closing}
					</p>
				)
			}
		</div>
	</section>
	<CtaBanner locale={locale} />
</BaseLayout>
