---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ServicesGrid from '../../../components/ServicesGrid.astro';
import { t } from '../../../i18n/copy';

const locale = 'es' as const;
const copy = t(locale);
---

<BaseLayout locale={locale} page="services" title={copy.meta.servicesTitle} description={copy.meta.servicesDescription}>
	<ServicesGrid locale={locale} detailed={true} heading="h1" />
</BaseLayout>
