---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { t } from '../../i18n/copy';

const locale = 'es' as const;
const copy = t(locale);
---

<BaseLayout locale={locale} page="about" title={copy.meta.aboutTitle} description={copy.meta.aboutDescription}>
	<section class="reveal mx-auto max-w-3xl px-4 py-16 sm:px-6">
		<h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{copy.about.title}</h1>
		<p class="mt-6 text-lg text-white/80">{copy.about.lede}</p>
		{
			copy.about.body.map((paragraph) => (
				<p class="mt-4 text-white/75">{paragraph}</p>
			))
		}
	</section>
	<CtaBanner locale={locale} />
</BaseLayout>
